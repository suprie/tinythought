# Copy to .env for local development, and to /opt/tinythought/.env on the VPS.
# Never commit the real file.

# PostgreSQL connection string. On the VPS this points at the shared database
# container over the vps-data network. Keep the password URL-safe.
DATABASE_URL=postgres://tinythought:change-me@localhost:5432/tinythought

# Bearer token required by POST /posts and GET /migrate.
# Generate with: openssl rand -hex 32
AUTH_TOKEN=change-me

# Absolute public origin, no trailing slash. Used for canonical links, Open
# Graph/Twitter cards, robots.txt, and sitemap.xml.
SITE_URL=https://blog.suprie.id
