# Copy to .env for local development. Use the VPS values in README.md for deployment.
# Never commit the real file.

# Matches the PostgreSQL container in compose.dev.yml.
DATABASE_URL=postgres://tinythought:tinythought@localhost:5432/tinythought

# One admin account. Generate the hash with: cargo run --bin hash_admin_password
# Wrap the generated hash in single quotes to preserve its dollar signs in Compose.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='replace-with-generated-hash'

# Absolute public origin, no trailing slash. Used for canonical links, Open
# Graph/Twitter cards, robots.txt, and sitemap.xml.
SITE_URL=http://localhost:3000
