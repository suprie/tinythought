  "db_name": "PostgreSQL",
  "query": "\n            Select\n                p.id,\n                p.title,\n                p.slug,\n                c.id as category_id,\n                c.title as category_name,\n                c.slug as category_slug,\n                p.body_markdown as raw,\n                p.body_html as html,\n                p.created_at as created_at\n            FROM posts AS p\n            INNER JOIN categories as C\n            ON c.id = p.category_id\n            WHERE p.slug = $1\n            ",
